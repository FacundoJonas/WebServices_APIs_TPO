      formLogin.classList.remove('hidden');
      formLogin.classList.add('flex');
      formRegister.classList.add('hidden');
      formRegister.classList.remove('flex');
    }

    function switchToRegister() {
      tabRegister.classList.add('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
      tabRegister.classList.remove('text-on-surface-variant');
      tabLogin.classList.remove('bg-surface-container-lowest', 'text-on-surface', 'shadow-sm');
      tabLogin.classList.add('text-on-surface-variant');
      formRegister.classList.remove('hidden');
      formRegister.classList.add('flex');
      formLogin.classList.add('hidden');
      formLogin.classList.remove('flex');
    }

    if (tabLogin && tabRegister) {
      tabLogin.addEventListener('click', switchToLogin);
      tabRegister.addEventListener('click', switchToRegister);
    }

    if (linkToRegister) linkToRegister.addEventListener('click', switchToRegister);
    if (linkToLogin) linkToLogin.addEventListener('click', switchToLogin);

    if (togglePwdBtn && pwdInput && togglePwdIcon) {
      togglePwdBtn.addEventListener('click', function() {
        const isPassword = pwdInput.getAttribute('type') === 'password';
        pwdInput.setAttribute('type', isPassword ? 'text' : 'password');
        togglePwdIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
      });
    }
  })();
</script></main></body></html>