<script>
  function switchAuthTab(mode) {
    const loginBtn = document.getElementById('tab-login-btn');
    const regBtn = document.getElementById('tab-register-btn');
    const loginPanel = document.getElementById('login-panel');
    const regPanel = document.getElementById('register-panel');

    if (mode === 'login') {
      loginBtn.setAttribute('aria-selected', 'true');
      loginBtn.className = "flex-1 h-11 rounded-lg font-body-md-medium text-body-md-medium transition-all duration-200 bg-surface-container-lowest text-on-surface shadow-sm flex items-center justify-center gap-1.5 active:scale-[0.98]";
      
      regBtn.setAttribute('aria-selected', 'false');
      regBtn.className = "flex-1 h-11 rounded-lg font-body-md-medium text-body-md-medium transition-all duration-200 text-on-surface-variant hover:text-on-surface flex items-center justify-center gap-1.5 active:scale-[0.98]";

      loginPanel.classList.remove('hidden');
      loginPanel.classList.add('flex');
      regPanel.classList.add('hidden');
      regPanel.classList.remove('flex');
    } else {
      regBtn.setAttribute('aria-selected', 'true');
      regBtn.className = "flex-1 h-11 rounded-lg font-body-md-medium text-body-md-medium transition-all duration-200 bg-surface-container-lowest text-on-surface shadow-sm flex items-center justify-center gap-1.5 active:scale-[0.98]";
      
      loginBtn.setAttribute('aria-selected', 'false');
      loginBtn.className = "flex-1 h-11 rounded-lg font-body-md-medium text-body-md-medium transition-all duration-200 text-on-surface-variant hover:text-on-surface flex items-center justify-center gap-1.5 active:scale-[0.98]";

      regPanel.classList.remove('hidden');
      regPanel.classList.add('flex');
      loginPanel.classList.add('hidden');
      loginPanel.classList.remove('flex');
    }
  }

  function togglePasswordVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (!input || !icon) return;

    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }
</script></main></body></html>