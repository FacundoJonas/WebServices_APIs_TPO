  function focusPaymentMethod() {
    const section = document.getElementById('payment-methods-section');
    if (section) {
      section.scrollIntoView({ behavior: 'smooth', block: 'center' });
      // Suggest alternate method
      const mcRadio = document.querySelector('input[value="mc_9012"]');
      if (mcRadio) {
        mcRadio.checked = true;
        mcRadio.dispatchEvent(new Event('change'));
      }
    }
  }

  function toggleCardFormManual() {
    const form = document.getElementById('new-card-form');
    const arrow = document.getElementById('accordion-arrow');
    const isHidden = form.classList.contains('hidden');
    
    if (isHidden) {
      form.classList.remove('hidden');
      arrow.textContent = 'expand_less';
      // uncheck stored radios
      document.querySelectorAll('input[name="payment_method"]').forEach(r => r.checked = false);
    } else {
      form.classList.add('hidden');
      arrow.textContent = 'expand_more';
    }
  }

  function toggleCardForm(show) {
    const form = document.getElementById('new-card-form');
    const arrow = document.getElementById('accordion-arrow');
    if (!form || !arrow) return;
    if (show) {
      form.classList.remove('hidden');
      arrow.textContent = 'expand_less';
    } else {
      form.classList.add('hidden');
      arrow.textContent = 'expand_more';
    }
  }

  function selectInstallmentOption(show) {
    const inst = document.getElementById('installments-container');
    if (inst) {
      inst.style.display = show ? 'block' : 'none';
    }
  }

  function toggleOrderItems() {
    const list = document.getElementById('order-items-list');
    const icon = document.getElementById('items-collapse-icon');
    if (list.classList.contains('hidden')) {
      list.classList.remove('hidden');
      icon.textContent = 'expand_less';
    } else {
      list.classList.add('hidden');
      icon.textContent = 'expand_more';
    }
  }

  function detectBrand(input) {
    const badge = document.getElementById('card-brand-badge');
    const value = input.value.replace(/\s+/g, '');
    if (value.startsWith('4')) {
      badge.textContent = 'Visa Débito / Crédito';
      badge.className = 'font-caption-bold text-caption-bold px-2 py-0.5 rounded bg-primary-fixed text-on-primary-fixed';
    } else if (value.startsWith('5')) {
      badge.textContent = 'Mastercard';
      badge.className = 'font-caption-bold text-caption-bold px-2 py-0.5 rounded bg-tertiary-fixed text-on-tertiary-fixed';
    } else if (value.startsWith('3')) {
      badge.textContent = 'American Express';
      badge.className = 'font-caption-bold text-caption-bold px-2 py-0.5 rounded bg-surface-container-highest text-on-surface';
    } else if (value.length === 0) {
      badge.textContent = 'Detectando...';
      badge.className = 'font-caption-bold text-caption-bold px-2 py-0.5 rounded bg-surface-container text-on-surface-variant';
    }
  }

  function saveMockCard() {
    const num = document.getElementById('input-card-number').value || '5500 1234 5678 9900';
    const lastFour = num.slice(-4);
    alert('Nueva tarjeta terminada en ' + lastFour + ' agregada con éxito. Ya podés confirmar tu compra.');
    toggleCardForm(false);
  }

  function handlePayAction() {
    const selected = document.querySelector('input[name="payment_method"]:checked');
    if (selected && selected.value === 'visa_4821') {
      const banner = document.getElementById('payment-error-banner');
      banner.classList.add('animate-pulse');
      setTimeout(() => banner.classList.remove('animate-pulse'), 1000);
      alert('Atención: La tarjeta Visa Débito •••• 4821 está rechazada por fondos insuficientes. Por favor seleccioná otro medio de pago.');
      return;
    }

    const btn = document.getElementById('pay-confirm-button');
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined text-[24px] animate-spin">refresh</span><span>Procesando pago seguro en ARS...</span>';
    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined text-[24px]">check_circle</span><span>¡Pago acreditado! Redirigiendo...</span>';
      btn.classList.remove('bg-primary-container');
      btn.classList.add('bg-primary');
    }, 1800);
  }
