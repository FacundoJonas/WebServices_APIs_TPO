<script>
  (function() {
    const markAllReadBtn = document.getElementById('mark-all-read-btn');
    const toggleEmptyBtn = document.getElementById('toggle-empty-state-btn');
    const restoreFeedBtn = document.getElementById('restore-feed-btn');
    const feed = document.getElementById('notifications-feed');
    const emptyState = document.getElementById('empty-state-view');
    const unreadBadge = document.getElementById('unread-badge');
    const filterTabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.notif-card');
    const sections = document.querySelectorAll('.group-section');

    // Mark all as read micro-interaction
    if (markAllReadBtn) {
      markAllReadBtn.addEventListener('click', function() {
        const unreadDots = document.querySelectorAll('.unread-dot');
        unreadDots.forEach(dot => dot.remove());

        cards.forEach(card => card.setAttribute('data-status', 'read'));
        if (unreadBadge) {
          unreadBadge.textContent = '0 nuevas';
          unreadBadge.classList.remove('bg-primary-fixed', 'text-on-primary-container');
          unreadBadge.classList.add('bg-surface-container', 'text-secondary');
        }

        markAllReadBtn.innerHTML = '<span class="material-symbols-outlined text-primary-container text-[20px]">check</span><span>Todas leídas</span>';
        markAllReadBtn.disabled = true;
      });
    }

    // Toggle Empty State for demonstration
    if (toggleEmptyBtn) {
      toggleEmptyBtn.addEventListener('click', function() {
        const isHidden = emptyState.classList.contains('hidden');
        if (isHidden) {
          feed.classList.add('hidden');
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          toggleEmptyBtn.querySelector('span:last-child').textContent = 'Ver lista de notificaciones';
        } else {
          feed.classList.remove('hidden');
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');
          toggleEmptyBtn.querySelector('span:last-child').textContent = 'Ver estado vacío';
        }
      });
    }

    if (restoreFeedBtn) {
      restoreFeedBtn.addEventListener('click', function() {
        feed.classList.remove('hidden');
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');
        if (toggleEmptyBtn) {
          toggleEmptyBtn.querySelector('span:last-child').textContent = 'Ver estado vacío';
        }
      });
    }

    // Category Filtering Logic
    filterTabs.forEach(tab => {
      tab.addEventListener('click', function() {
        filterTabs.forEach(t => {
          t.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm');
          t.classList.add('bg-surface-container-low', 'text-on-surface');
        });
        this.classList.remove('bg-surface-container-low', 'text-on-surface');
        this.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm');

        const filter = this.getAttribute('data-filter');

        let visibleCount = 0;
        cards.forEach(card => {
          const type = card.getAttribute('data-type');
          if (filter === 'all' || type === filter) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Hide empty headers if all their cards are hidden
        sections.forEach(sec => {
          const visibleInSec = sec.querySelectorAll('.notif-card:not(.hidden)');
          if (visibleInSec.length === 0) {
            sec.classList.add('hidden');
          } else {
            sec.classList.remove('hidden');
          }
        });
      });
    });
  })();
