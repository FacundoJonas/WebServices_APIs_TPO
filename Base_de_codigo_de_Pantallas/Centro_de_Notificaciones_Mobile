<script>
  function markAllAsRead() {
    const dots = document.querySelectorAll('.unread-indicator');
    dots.forEach(dot => dot.classList.add('hidden'));

    const badge = document.getElementById('badge-counter');
    if (badge) {
      badge.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span><span class="font-caption-bold text-caption-bold">Al día</span>';
      badge.classList.remove('text-primary');
      badge.classList.add('text-on-surface-variant');
    }

    const navBadge = document.getElementById('nav-badge');
    if (navBadge) {
      navBadge.classList.add('hidden');
    }

    const btnMark = document.getElementById('btn-mark-all');
    if (btnMark) {
      btnMark.style.opacity = '0.5';
      btnMark.style.pointerEvents = 'none';
    }
  }

  function toggleEmptyState() {
    const feed = document.getElementById('notifications-list');
    const empty = document.getElementById('empty-state-view');
    const badge = document.getElementById('badge-counter');
    const btnMark = document.getElementById('btn-mark-all');

    if (feed.classList.contains('hidden')) {
      feed.classList.remove('hidden');
      empty.classList.add('hidden');
      empty.classList.remove('flex');
      if (badge) badge.classList.remove('opacity-0');
      if (btnMark) btnMark.classList.remove('opacity-0');
    } else {
      feed.classList.add('hidden');
      empty.classList.remove('hidden');
      empty.classList.add('flex');
      if (badge) badge.classList.add('opacity-0');
      if (btnMark) btnMark.classList.add('opacity-0');
    }
  }
