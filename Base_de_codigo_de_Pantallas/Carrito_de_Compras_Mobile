<!-- Microinteracciones y Control de Estado -->
<script>
  let isEmptyState = false;

  function toggleCartState(forceState) {
    if (typeof forceState === 'boolean') {
      isEmptyState = forceState;
    } else {
      isEmptyState = !isEmptyState;
    }

    const filledContent = document.getElementById('cart-content-wrapper');
    const emptyContent = document.getElementById('cart-empty-wrapper');
    const bottomBar = document.getElementById('fixed-bottom-bar');
    const toggleLabel = document.getElementById('toggle-label');

    if (isEmptyState) {
      filledContent.classList.add('hidden');
      emptyContent.classList.remove('hidden');
      emptyContent.classList.add('flex');
      bottomBar.classList.add('translate-y-full');
      toggleLabel.textContent = 'Ver Carrito Lleno';
    } else {
      emptyContent.classList.add('hidden');
      emptyContent.classList.remove('flex');
      filledContent.classList.remove('hidden');
      bottomBar.classList.remove('translate-y-full');
      toggleLabel.textContent = 'Simular Vacío';
    }
  }

  document.getElementById('toggle-empty-state-btn').addEventListener('click', () => {
    toggleCartState();
  });

  function removeItem(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      el.remove();
      const remainingItems = document.querySelectorAll('#cart-content-wrapper article');
      if (remainingItems.length === 0) {
        toggleCartState(true);
      }
    }, 200);
  }
</script></main></body></html>