<script>
  let quantities = {
    1: 1,
    2: 2
  };
  let prices = {
    1: 7800,
    2: 3900
  };
  let shippingCost = 850;
  let serviceCost = 350;
  let discountAmount = 1500;
  let couponActive = true;

  function recalculateTotal() {
    let subtotal = (quantities[1] || 0) * prices[1] + (quantities[2] || 0) * prices[2];
    
    // Check if both items removed
    if ((quantities[1] || 0) === 0 && (quantities[2] || 0) === 0) {
      showEmptyCart();
      return;
    }

    let finalDiscount = couponActive ? discountAmount : 0;
    let total = Math.max(0, subtotal + shippingCost + serviceCost - finalDiscount);

    const subEl = document.getElementById('summary-subtotal');
    if (subEl) subEl.textContent = '$' + subtotal.toLocaleString('es-AR');

    const totEl = document.getElementById('summary-total');
    if (totEl) totEl.textContent = '$' + total.toLocaleString('es-AR');

    const btnTotEl = document.getElementById('btn-total-label');
    if (btnTotEl) btnTotEl.textContent = '$' + total.toLocaleString('es-AR');
  }

  function updateQty(id, delta, unitPrice) {
    let current = quantities[id] || 0;
    let newQty = current + delta;

    if (newQty <= 0) {
      removeItem(id);
      return;
    }

    quantities[id] = newQty;
    const qtyEl = document.getElementById('item-' + id + '-qty');
    if (qtyEl) qtyEl.textContent = newQty;

    const subEl = document.getElementById('item-' + id + '-subtotal');
    if (subEl) subEl.textContent = '$' + (newQty * unitPrice).toLocaleString('es-AR');

    recalculateTotal();
  }

  function removeItem(id) {
    quantities[id] = 0;
    const cardEl = document.getElementById('cart-item-' + id);
    if (cardEl) {
      cardEl.style.opacity = '0';
      cardEl.style.transform = 'scale(0.95)';
      setTimeout(function() {
        cardEl.remove();
        recalculateTotal();
      }, 200);
    }
  }

  function removeCoupon() {
    couponActive = false;
    const pill = document.getElementById('coupon-pill');
    if (pill) pill.classList.add('hidden');
    
    const row = document.getElementById('summary-discount-row');
    if (row) row.classList.add('hidden');

    const input = document.getElementById('coupon-input');
    if (input) input.value = '';

    recalculateTotal();
  }

  function applyCoupon() {
    const input = document.getElementById('coupon-input');
    if (input && input.value.trim().toUpperCase() === 'DELIVERYGO20') {
      couponActive = true;
      const pill = document.getElementById('coupon-pill');
      if (pill) pill.classList.remove('hidden');

      const row = document.getElementById('summary-discount-row');
      if (row) row.classList.remove('hidden');

      recalculateTotal();
    }
  }

  function addUpsell(price, name) {
    // Add extra price to burger item for demonstration
    quantities[1] = (quantities[1] || 1) + 1;
    const qtyEl = document.getElementById('item-1-qty');
    if (qtyEl) qtyEl.textContent = quantities[1];

    const subEl = document.getElementById('item-1-subtotal');
    if (subEl) subEl.textContent = '$' + (quantities[1] * prices[1]).toLocaleString('es-AR');

    recalculateTotal();
  }

  function showEmptyCart() {
    const activeView = document.getElementById('active-cart-view');
    const emptyView = document.getElementById('empty-cart-view');
    const crossSection = document.getElementById('cross-sell-section');

    const activeBtn = document.getElementById('toggle-active-btn');
    const emptyBtn = document.getElementById('toggle-empty-btn');

    if (activeView) activeView.classList.add('hidden');
    if (crossSection) crossSection.classList.add('hidden');
    if (emptyView) {
      emptyView.classList.remove('hidden');
      emptyView.classList.add('flex');
    }

    if (activeBtn && emptyBtn) {
      activeBtn.className = 'flex items-center gap-1.5 px-space-md py-1.5 rounded-full font-label-md text-secondary hover:text-on-surface transition-all duration-200';
      emptyBtn.className = 'flex items-center gap-1.5 px-space-md py-1.5 rounded-full font-label-md bg-surface-container-lowest text-on-surface shadow-sm transition-all duration-200';
    }
  }

  function showActiveCart() {
    const activeView = document.getElementById('active-cart-view');
    const emptyView = document.getElementById('empty-cart-view');
    const crossSection = document.getElementById('cross-sell-section');

    const activeBtn = document.getElementById('toggle-active-btn');
    const emptyBtn = document.getElementById('toggle-empty-btn');

    if (emptyView) {
      emptyView.classList.add('hidden');
      emptyView.classList.remove('flex');
    }
    if (activeView) activeView.classList.remove('hidden');
    if (crossSection) crossSection.classList.remove('hidden');

    if (activeBtn && emptyBtn) {
      emptyBtn.className = 'flex items-center gap-1.5 px-space-md py-1.5 rounded-full font-label-md text-secondary hover:text-on-surface transition-all duration-200';
      activeBtn.className = 'flex items-center gap-1.5 px-space-md py-1.5 rounded-full font-label-md bg-surface-container-lowest text-on-surface shadow-sm transition-all duration-200';
    }
  }
