<script>
  function toggleOrderSummary() {
    const content = document.getElementById('summary-content');
    const chevron = document.getElementById('summary-chevron');
    const isHidden = content.classList.contains('hidden');
    
    if (isHidden) {
      content.classList.remove('hidden');
      chevron.style.transform = 'rotate(180deg)';
    } else {
      content.classList.add('hidden');
      chevron.style.transform = 'rotate(0deg)';
    }
  }

  function openCardSheet() {
    const sheet = document.getElementById('card-sheet');
    sheet.classList.remove('hidden');
  }

  function closeCardSheet() {
    const sheet = document.getElementById('card-sheet');
    sheet.classList.add('hidden');
  }

  function toggleInstallments(show) {
    const box = document.getElementById('installments-box');
    if (show) {
      box.classList.remove('opacity-40', 'pointer-events-none');
    } else {
      box.classList.add('opacity-40', 'pointer-events-none');
    }
  }

  function updateInstallment(val) {
    const btn = document.getElementById('btn-pay');
    if (val === '1') {
      btn.innerHTML = '<span class="material-symbols-outlined">lock</span><span>Confirmar y pagar $ 19.300</span>';
    } else if (val === '3') {
      btn.innerHTML = '<span class="material-symbols-outlined">lock</span><span>Confirmar en 3 cuotas de $ 7.100</span>';
    } else {
      btn.innerHTML = '<span class="material-symbols-outlined">lock</span><span>Confirmar en 6 cuotas de $ 3.980</span>';
    }
  }

  function handleSaveCard(e) {
    e.preventDefault();
    closeCardSheet();
    alert('¡Tarjeta guardada con éxito! Ahora podés continuar con el pago.');
  }

  function simulatePayment(btn) {
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined animate-spin">refresh</span><span>Procesando pago...</span>';
    setTimeout(() => {
      btn.innerHTML = '<span class="material-symbols-outlined">check_circle</span><span>¡Pago aprobado! Redirigiendo...</span>';
      btn.classList.remove('bg-primary-container');
      btn.classList.add('bg-primary');
    }, 1500);
  }
</script></main></body></html>