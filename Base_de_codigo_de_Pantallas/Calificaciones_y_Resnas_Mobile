<script>
  (function() {
    // Rating labels map
    const ratingTexts = {
      1: 'Malo',
      2: 'Regular',
      3: 'Bueno',
      4: 'Muy bueno',
      5: 'Excelente'
    };

    // Store Stars Handler
    const storeStars = document.querySelectorAll('.star-btn-store');
    const storeLabel = document.getElementById('store-rating-label');
    let currentStoreRating = 5;

    function updateStars(buttons, rating, labelEl) {
      buttons.forEach(btn => {
        const btnRating = parseInt(btn.dataset.rating, 10);
        const icon = btn.querySelector('.material-symbols-outlined');
        if (btnRating <= rating) {
          btn.classList.add('text-primary');
          btn.classList.remove('text-surface-variant');
          icon.style.fontVariationSettings = "'FILL' 1";
        } else {
          btn.classList.remove('text-primary');
          btn.classList.add('text-surface-variant');
          icon.style.fontVariationSettings = "'FILL' 0";
        }
      });
      if (labelEl && ratingTexts[rating]) {
        labelEl.textContent = ratingTexts[rating];
      }
    }

    storeStars.forEach(btn => {
      btn.addEventListener('click', () => {
        currentStoreRating = parseInt(btn.dataset.rating, 10);
        updateStars(storeStars, currentStoreRating, storeLabel);
      });
    });

    // Courier Stars Handler
    const courierStars = document.querySelectorAll('.star-btn-courier');
    const courierLabel = document.getElementById('courier-rating-label');
    let currentCourierRating = 5;

    courierStars.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCourierRating = parseInt(btn.dataset.rating, 10);
        updateStars(courierStars, currentCourierRating, courierLabel);
      });
    });

    // Toggle Tag Chips
    const tagChips = document.querySelectorAll('.tag-chip');
    tagChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const isSelected = chip.dataset.selected === 'true';
        if (isSelected) {
          chip.dataset.selected = 'false';
          chip.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          chip.classList.add('bg-surface-container-high', 'text-on-surface');
        } else {
          chip.dataset.selected = 'true';
          chip.classList.remove('bg-surface-container-high', 'text-on-surface');
          chip.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
        }
      });
    });

    // Textarea Char Counter
    const textarea = document.getElementById('review-text');
    const charCounter = document.getElementById('char-counter');
    if (textarea && charCounter) {
      textarea.addEventListener('input', () => {
        const len = textarea.value.length;
        charCounter.textContent = len + '/500';
      });
    }

    // Helpful Buttons Upvote
    const helpfulBtns = document.querySelectorAll('.helpful-btn');
    helpfulBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const isVoted = btn.dataset.voted === 'true';
        let count = parseInt(btn.dataset.count, 10);
        const countSpan = btn.querySelector('.count');

        if (!isVoted) {
          count += 1;
          btn.dataset.voted = 'true';
          btn.dataset.count = count;
          countSpan.textContent = count;
          btn.classList.add('bg-primary/15', 'text-primary');
          btn.classList.remove('bg-surface-container', 'text-on-surface');
          btn.querySelector('.material-symbols-outlined').style.fontVariationSettings = "'FILL' 1";
        } else {
          count -= 1;
          btn.dataset.voted = 'false';
          btn.dataset.count = count;
          countSpan.textContent = count;
          btn.classList.remove('bg-primary/15', 'text-primary');
          btn.classList.add('bg-surface-container', 'text-on-surface');
          btn.querySelector('.material-symbols-outlined').style.fontVariationSettings = "'FILL' 0";
        }
      });
    });

    // Submit Action Feedback
    const submitBtn = document.getElementById('submit-review-btn');
    if (submitBtn) {
      submitBtn.addEventListener('click', () => {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <span class="material-symbols-outlined text-[20px] animate-spin">progress_activity</span>
          <span>Publicando calificación...</span>
        `;
        setTimeout(() => {
          submitBtn.innerHTML = `
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>¡Gracias por calificar!</span>
          `;
          submitBtn.classList.replace('bg-primary-container', 'bg-primary');
        }, 800);
      });
    }
  })();
</script></main></body></html>