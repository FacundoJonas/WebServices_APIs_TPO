<script>
  (function() {
    const starDescriptions = {
      1: "Malo - 1 estrella",
      2: "Regular - 2 estrellas",
      3: "Bueno - 3 estrellas",
      4: "Muy bueno - 4 estrellas",
      5: "Excelente - 5 estrellas"
    };

    function setupStarRating(groupSelector, labelSelector) {
      const group = document.querySelector(groupSelector);
      const label = document.querySelector(labelSelector);
      if (!group || !label) return;

      const buttons = group.querySelectorAll('button');
      let currentRating = 0;

      function updateStars(val) {
        buttons.forEach(btn => {
          const btnVal = parseInt(btn.getAttribute('data-val'), 10);
          if (btnVal <= val) {
            btn.classList.remove('text-secondary-container');
            btn.classList.add('text-[#E5A000]');
          } else {
            btn.classList.remove('text-[#E5A000]');
            btn.classList.add('text-secondary-container');
          }
        });
      }

      buttons.forEach(btn => {
        const val = parseInt(btn.getAttribute('data-val'), 10);

        btn.addEventListener('mouseenter', () => {
          updateStars(val);
          label.textContent = starDescriptions[val];
        });

        btn.addEventListener('mouseleave', () => {
          updateStars(currentRating);
          label.textContent = currentRating > 0 ? starDescriptions[currentRating] : "Tocá una estrella";
        });

        btn.addEventListener('click', () => {
          currentRating = val;
          updateStars(currentRating);
          label.textContent = starDescriptions[currentRating];
        });
      });
    }

    setupStarRating('#store-stars-group', '#store-rating-label');
    setupStarRating('#courier-stars-group', '#courier-rating-label');

    // Quick chips toggle
    const chips = document.querySelectorAll('.quick-chip');
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const isSelected = chip.classList.contains('bg-primary-container');
        if (isSelected) {
          chip.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm');
          chip.classList.add('bg-surface', 'text-on-surface');
          const icon = chip.querySelector('.material-symbols-outlined');
          if (icon) {
            icon.classList.remove('text-on-primary');
            icon.classList.add('text-primary-container');
          }
        } else {
          chip.classList.remove('bg-surface', 'text-on-surface');
          chip.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm');
          const icon = chip.querySelector('.material-symbols-outlined');
          if (icon) {
            icon.classList.remove('text-primary-container');
            icon.classList.add('text-on-primary');
          }
        }
      });
    });

    // Character counter
    const textarea = document.getElementById('review-textarea');
    const charCounter = document.getElementById('char-counter');
    if (textarea && charCounter) {
      textarea.addEventListener('input', () => {
        const len = textarea.value.length;
        charCounter.textContent = `${len} / 500`;
        if (len > 500) {
          textarea.value = textarea.value.substring(0, 500);
          charCounter.textContent = `500 / 500`;
        }
      });
    }

    // Submit handler & modal display
    const submitBtn = document.getElementById('submit-review-btn');
    const modal = document.getElementById('review-success-modal');
    const closeModal = document.getElementById('close-modal-btn');

    if (submitBtn && modal) {
      submitBtn.addEventListener('click', () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    }

    if (closeModal && modal) {
      closeModal.addEventListener('click', () => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
      });
