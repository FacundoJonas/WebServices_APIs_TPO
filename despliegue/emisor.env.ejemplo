# =====================================================================
#  Configuración del EMISOR (Módulo Pedidos)
#  Se instala en /etc/deliverygo/emisor-pedidos.env
#  Después de editar: sudo systemctl restart deliverygo-emisor
# =====================================================================

# Puerto en el que escucha la API
PUERTO=8081

# 0.0.0.0 = acepta conexiones de otras PCs. 127.0.0.1 = sólo desde esta VM.
HOST=0.0.0.0

# >>> CAMBIAR: IP y puerto de la VM donde corre el RECEPTOR <<<
# Nunca "localhost" si el receptor está en otra VM.
RECEPTOR_URL=http://192.168.1.22:8082

# Tiempo máximo para abrir la conexión TCP con el receptor (ms)
RECEPTOR_TIMEOUT_CONEXION_MS=3000
# Tiempo máximo para recibir la respuesta del receptor (ms)
RECEPTOR_TIMEOUT_LECTURA_MS=5000

# Orígenes permitidos para el Portal React (CORS)
CORS_ORIGENES=*

# Consola web de H2 (desactivada por seguridad)
H2_CONSOLA=false
