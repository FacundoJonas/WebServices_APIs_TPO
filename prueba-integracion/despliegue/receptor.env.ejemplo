# =====================================================================
#  Configuración del RECEPTOR (Módulo Notificaciones)
#  Se instala en /etc/deliverygo/receptor-notificaciones.env
#  Después de editar: sudo systemctl restart deliverygo-receptor
# =====================================================================

# Puerto en el que escucha la API
PUERTO=8082

# 0.0.0.0 = acepta conexiones de otras PCs. 127.0.0.1 = sólo desde esta VM.
HOST=0.0.0.0

# Orígenes permitidos para el Portal React (CORS). Ej: http://192.168.1.50:5173
CORS_ORIGENES=*

# --- Simulación de fallas (para probar al emisor). 0 = desactivado ---
# Demora antes de responder, en milisegundos (8000 provoca timeout en el emisor)
SIMULAR_DEMORA_MS=0
# Porcentaje (0-100) de solicitudes que responden 503 a propósito
SIMULAR_FALLA_PORCENTAJE=0

# Consola web de H2 (desactivada por seguridad)
H2_CONSOLA=false

# --- Entrega simulada y reintentos ---
# Tope de intentos de entrega, contando el primero (regla "reintentos limitados")
MAX_INTENTOS=3
# Canales que arrancan caídos, separados por coma (ej. EMAIL). Vacío = todos operativos.
# También se cambian en caliente desde la página del receptor.
CANALES_CAIDOS=
