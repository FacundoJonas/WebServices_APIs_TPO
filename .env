# Configuración compartida por todas las PCs (la usa la PC del equipo 008).
# Si en tu máquina necesitás otro valor, ponelo en .env.local: tiene prioridad
# sobre este archivo y no se sube a GitHub.

# Prefijos que usa el Portal para cada módulo (los lee src/servicies/api.js).
VITE_USUARIOS_URL=/usuarios-api
VITE_CATALOGO_URL=/catalogo-api
VITE_PEDIDOS_URL=/pedidos-api
VITE_PAGOS_URL=/pagos-api
VITE_REPARTIDORES_LOGISTICA_URL=/repartidores-logistica-api
VITE_NOTIF_URL=/notif-api
VITE_OPINIONES_ANALITICA_URL=/opiniones-analitica-api
VITE_NOTIF_URL=/notif-api

# Direcciones reales de los módulos, para el proxy de vite.config.js.
# Sin el prefijo VITE_: no llegan al navegador.
USUARIOS_PROXY_TARGET=http://192.168.1.180:8080
//EQUIPO 001
CATALOGO_PROXY_TARGET=http://192.168.1.170:8080
//EQUIPO 002
PEDIDOS_PROXY_TARGET=http://192.168.1.160:8080
//EQUIPO 003
PAGOS_PROXY_TARGET=http://192.168.1.121:8080
//EQUIPO 004
REPARTIDORES_LOGISTICA_PROXY_TARGET=http://192.168.1.117:8080
//EQUIPO 005
NOTIF_PROXY_TARGET=http://192.168.1.174:8089 
//EQUIPO 006
OPINIONES_ANALITICA_PROXY_TARGET=http://192.168.1.118:8080
//EQUIPO 007

# Completar con la IP y el puerto del equipo de Notificaciones (006):
# NOTIF_PROXY_TARGET=http://<ip>:<puerto>
